# รหัสลับสำหรับรีเซ็ตรหัสผ่าน (Master Reset Code)
[security]
admin_reset_code = "KuromiBlackCat"
admin_contact = "Herren@Onelink.co.th"

# URL ของเว็บแอป (เมื่อ Deploy บน Streamlit Cloud แล้ว)
app_url = "https://your-app-name.streamlit.app"

# การเชื่อมต่อ Microsoft Teams Group Chat (นำ Webhook URL จาก Workflows มาใส่ที่นี่)
[teams]
webhook_url = "https://prod-xx.southeastasia.logic.azure.com:443/workflows/xxxx/triggers/manual/paths/invoke?api-version=2016-06-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=xxxx"

# การเชื่อมต่อ Email สำรอง (SMTP)
[email]
smtp_server = "smtp.gmail.com"
smtp_port = 587
sender_email = "your-system-notification@gmail.com"
sender_password = "xxxx xxxx xxxx xxxx"
receiver_email = "team-channel@company.com"

# การเชื่อมต่อ Google Sheets ผ่าน Streamlit
[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE/edit"
